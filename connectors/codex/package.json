{
  "name": "@promptlens/connector-codex",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "promptlens-codex": "dist/cli.js"
  },
  "files": [
    "dist",
    "connector.json",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist',{recursive:true,force:true})\"",
    "lint": "eslint src",
    "test": "vitest run --passWithNoTests --exclude dist/**",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@napi-rs/keyring": "1.3.0",
    "@promptlens/connector-sdk": "workspace:*"
  },
  "devDependencies": {
    "vitest": "4.1.10"
  }
}
